{
  "slug": "actions-customerio-audiences",
  "name": "Customer.io Audiences (Actions)",
  "mode": "cloud",
  "description": "Sync Segment Engage audiences to Customer.io. Each audience becomes a data-driven segment on a boolean profile attribute named after the audience key.",
  "authentication": {
    "scheme": "basic",
    "fields": {
      "siteId": {
        "label": "Site ID",
        "description": "Customer.io site ID. This can be found on your [API Credentials page](https://fly.customer.io/settings/api_credentials).",
        "type": "password",
        "required": true,
        "multiple": false,
        "choices": null,
        "default": null,
        "depends_on": null
      },
      "apiKey": {
        "label": "API Key",
        "description": "Customer.io API key. This can be found on your [API Credentials page](https://fly.customer.io/settings/api_credentials).",
        "type": "password",
        "required": true,
        "multiple": false,
        "choices": null,
        "default": null,
        "depends_on": null
      },
      "appApiKey": {
        "label": "App API Key",
        "description": "Customer.io App API key, used to create and look up the segment for each audience. This can be found on your [API Credentials page](https://fly.customer.io/settings/api_credentials?keyType=app).",
        "type": "password",
        "required": true,
        "multiple": false,
        "choices": null,
        "default": null,
        "depends_on": null
      },
      "accountRegion": {
        "label": "Account Region",
        "description": "Learn about [Account Regions](https://customer.io/docs/data-centers/).",
        "type": "string",
        "required": false,
        "multiple": false,
        "choices": [
          {
            "label": "US 🇺🇸",
            "value": "US 🇺🇸"
          },
          {
            "label": "EU 🇪🇺",
            "value": "EU 🇪🇺"
          }
        ],
        "default": "US 🇺🇸",
        "depends_on": null
      }
    }
  },
  "audienceConfig": {
    "mode": {
      "type": "synced",
      "full_audience_sync": false
    },
    "audienceFields": {
      "segmentId": {
        "label": "Segment ID",
        "description": "Optional. The numeric ID of an existing Customer.io segment to link to this audience instead of creating a new one, for example a segment created earlier by this destination. The segment should select people whose attribute named after the audience key is true.",
        "type": "string",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": null,
        "depends_on": null
      }
    },
    "supportsAudienceFunctions": true
  },
  "actions": {
    "syncAudience": {
      "title": "Sync Audience Membership",
      "description": "Set a boolean profile attribute named after the audience key: true when a person enters the audience and false when they exit.",
      "platform": "cloud",
      "defaultSubscription": "event = \"Audience Entered\" or event = \"Audience Exited\"",
      "hidden": false,
      "hasPerformBatch": true,
      "syncMode": null,
      "hooks": null,
      "dynamicFields": null,
      "fields": {
        "person_id": {
          "label": "Person ID",
          "description": "The ID used to uniquely identify a person in Customer.io. A value prefixed with `cio_` is sent as a Customer.io ID and an email address is sent as an email. [Learn more](https://customer.io/docs/identifying-people/#identifiers).",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.userId"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "anonymous_id": {
          "label": "Anonymous ID",
          "description": "An anonymous ID to merge into the person, the same way the Customer.io (Actions) destination does. It cannot identify a person on its own.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.anonymousId"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "email": {
          "label": "Email",
          "description": "The email address of the person. Used as the identifier when Person ID is empty.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@if": {
              "exists": {
                "@path": "$.traits.email"
              },
              "then": {
                "@path": "$.traits.email"
              },
              "else": {
                "@if": {
                  "exists": {
                    "@path": "$.context.traits.email"
                  },
                  "then": {
                    "@path": "$.context.traits.email"
                  },
                  "else": {
                    "@path": "$.properties.email"
                  }
                }
              }
            }
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "audience_key": {
          "label": "Audience Key",
          "description": "The Engage audience key. It is used as the name of the boolean profile attribute in Customer.io and must match the attribute used by the audience segment.",
          "type": "string",
          "required": true,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.context.personas.computation_key"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": true,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "traits_or_properties": {
          "label": "Traits or Properties",
          "description": "The traits (identify) or properties (track) object sent by Engage. The value of the audience key in this object says whether the person entered (true) or exited (false) the audience.",
          "type": "object",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@if": {
              "exists": {
                "@path": "$.properties"
              },
              "then": {
                "@path": "$.properties"
              },
              "else": {
                "@path": "$.traits"
              }
            }
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": true,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "event_name": {
          "label": "Event Name",
          "description": "The Engage event name. Used to decide membership when the traits or properties do not contain the audience key: \"Audience Entered\" sets the attribute to true and \"Audience Exited\" sets it to false.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.event"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": true,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "timestamp": {
          "label": "Timestamp",
          "description": "When the membership change happened.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.timestamp"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "enable_batching": {
          "label": "Batch Data to Customer.io",
          "description": "Send membership changes to Customer.io in batches.",
          "type": "boolean",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": true,
          "choices": null,
          "placeholder": null,
