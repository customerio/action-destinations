    }
  },
  "presets": [
    {
      "name": "Audience Entered",
      "type": "automatic",
      "partnerAction": "syncAudience",
      "subscribe": "event = \"Audience Entered\"",
      "mapping": {
        "person_id": {
          "@path": "$.userId"
        },
        "anonymous_id": {
          "@path": "$.anonymousId"
        },
        "email": {
          "@if": {
            "exists": {
              "@path": "$.traits.email"
            },
            "then": {
              "@path": "$.traits.email"
            },
            "else": {
              "@if": {
                "exists": {
                  "@path": "$.context.traits.email"
                },
                "then": {
                  "@path": "$.context.traits.email"
                },
                "else": {
                  "@path": "$.properties.email"
                }
              }
            }
          }
        },
        "audience_key": {
          "@path": "$.context.personas.computation_key"
        },
        "traits_or_properties": {
          "@if": {
            "exists": {
              "@path": "$.properties"
            },
            "then": {
              "@path": "$.properties"
            },
            "else": {
              "@path": "$.traits"
            }
          }
        },
        "event_name": {
          "@path": "$.event"
        },
        "timestamp": {
          "@path": "$.timestamp"
        },
        "enable_batching": true,
        "batch_size": 1000
      },
      "eventSlug": null
    },
