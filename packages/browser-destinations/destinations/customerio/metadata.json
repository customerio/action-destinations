{
  "slug": "actions-customerio-web",
  "name": "Customer.io Web (Actions)",
  "mode": "device",
  "description": "Load the Customer.io JavaScript snippet in the browser to identify people, send events and page views, and display Customer.io web in-app messages.",
  "authentication": {
    "scheme": "custom",
    "fields": {
      "siteId": {
        "label": "Site ID",
        "description": "Your Customer.io workspace Site ID, shown in the JavaScript snippet under Integrations > Customer.io API.",
        "type": "string",
        "required": true,
        "multiple": false,
        "choices": null,
        "default": null,
        "depends_on": null
      },
      "region": {
        "label": "Region",
        "description": "The region your Customer.io account is hosted in. EU accounts load track-eu.js.",
        "type": "string",
        "required": true,
        "multiple": false,
        "choices": [
          {
            "label": "US",
            "value": "US"
          },
          {
            "label": "EU",
            "value": "EU"
          }
        ],
        "default": "US",
        "depends_on": null
      },
      "useInApp": {
        "label": "Enable In-App Messages",
        "description": "Load the Customer.io in-app messaging plugin (sets data-use-in-app=\"true\"). In-app messaging must also be enabled in your Customer.io workspace, and people must be identified to receive messages.",
        "type": "boolean",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": true,
        "depends_on": null
      },
      "autoTrackPage": {
        "label": "Automatically Track Page Views",
        "description": "When enabled, the Customer.io snippet sends its own page view when it loads (data-auto-track-page). Leave disabled if the Track Page action forwards Segment page calls, to avoid duplicate page views.",
        "type": "boolean",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": false,
        "depends_on": null
      },
      "useArrayParams": {
        "label": "Preserve Arrays",
        "description": "When enabled (data-use-array-params=\"true\"), arrays in identify and track calls keep their shape. When disabled, Customer.io converts arrays into objects keyed by index.",
        "type": "boolean",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": true,
        "depends_on": null
      },
      "crossSiteSupport": {
        "label": "Cross-Site Cookie Support",
        "description": "When enabled (data-cross-site-support=\"true\"), the snippet can set cookies from iframes within third-party domains, such as Shopify.",
        "type": "boolean",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": false,
        "depends_on": null
      },
      "enableInMemoryStorage": {
        "label": "In-Memory Storage Fallback",
        "description": "When enabled (data-enable-in-memory-storage=\"true\"), the snippet stores identity in memory when cookies are unavailable.",
        "type": "boolean",
        "required": false,
        "multiple": false,
        "choices": null,
        "default": false,
        "depends_on": null
      }
    }
  },
  "audienceConfig": null,
  "actions": {
    "identifyUser": {
      "title": "Identify User",
      "description": "Identify a person in Customer.io and update their attributes. People must be identified to receive web in-app messages.",
      "platform": "web",
      "defaultSubscription": "type = \"identify\"",
      "hidden": false,
      "hasPerformBatch": false,
      "syncMode": null,
      "hooks": null,
      "dynamicFields": null,
      "fields": {
        "userId": {
          "label": "Person ID",
          "description": "The ID that identifies the person in Customer.io. If empty, the email address is used as the ID, which Customer.io detects as an email identifier.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.userId"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "email": {
          "label": "Email Address",
          "description": "The person's email address. Used as the ID when Person ID is empty.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.traits.email"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": "email",
          "additionalProperties": false
        },
        "createdAt": {
          "label": "Created At",
          "description": "When the person was first created. Converted to a Unix timestamp (seconds) and sent as `created_at`. Customer.io recommends sending this only when you first identify someone.",
          "type": "datetime",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@if": {
              "exists": {
                "@path": "$.traits.created_at"
              },
              "then": {
                "@path": "$.traits.created_at"
              },
              "else": {
                "@path": "$.traits.createdAt"
              }
            }
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        },
        "attributes": {
          "label": "Person Attributes",
          "description": "Attributes to set on the person in Customer.io.",
          "type": "object",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.traits"
          },
          "choices": null,
          "placeholder": null,
          "properties": null,
          "category": null,
          "depends_on": null,
          "readOnly": null,
          "hidden": null,
          "minimum": null,
          "maximum": null,
          "defaultObjectUI": null,
          "disabledInputMethods": null,
          "displayMode": null,
          "format": null,
          "additionalProperties": false
        }
      }
    },
    "trackEvent": {
      "title": "Track Event",
      "description": "Send a custom event to Customer.io. Events sent before a person is identified are attributed to an anonymous visitor and merged when they are identified.",
      "platform": "web",
      "defaultSubscription": "type = \"track\"",
      "hidden": false,
      "hasPerformBatch": false,
      "syncMode": null,
      "hooks": null,
      "dynamicFields": null,
      "fields": {
        "name": {
          "label": "Event Name",
          "description": "The name of the event.",
          "type": "string",
          "required": true,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
            "@path": "$.event"
          },
          "choices": null,
