    "trackPage": {
      "title": "Track Page",
      "description": "Send a page view to Customer.io. Web in-app message page rules match against the page name, so single-page apps should forward every page call.",
      "platform": "web",
      "defaultSubscription": "type = \"page\"",
      "hidden": false,
      "hasPerformBatch": false,
      "syncMode": null,
      "hooks": null,
      "dynamicFields": null,
      "fields": {
        "name": {
          "label": "Page Name",
          "description": "The page name sent to Customer.io. Defaults to the page URL, which is what the Customer.io snippet uses for its own page views and what in-app page rules match against. If empty, the snippet uses the current URL.",
          "type": "string",
          "required": false,
          "multiple": false,
          "allowNull": false,
          "dynamic": false,
          "default": {
